<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="peli"
        Arguments=""
        InstallLocation="C:\Program Files\k22i\Peli">
    </Installer>
    <PackageInformation
        PackageName="Peli"
        PackageDisplayName="Peli"
        PublisherName="CN=k22i"
        PublisherDisplayName="k22i"
        Version="0.1.0.0"
        PackageDescription="A desktop client for Stremio-compatible addons, with Nuvio sync">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="k22i.net.peli"
                Description="A desktop client for Stremio-compatible addons, with Nuvio sync"
                DisplayName="Peli"
                ExecutableName="peli"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Peli</DisplayName>
            <PublisherDisplayName>k22i</PublisherDisplayName>
            <Description>A desktop client for Stremio-compatible addons, with Nuvio sync</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="peli.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
